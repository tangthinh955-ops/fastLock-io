@baseUrl = http://localhost:3001
@adminToken = PASTE_ADMIN_TOKEN
@sellerToken = PASTE_SELLER_TOKEN
@buyerToken = PASTE_BUYER_TOKEN
@sellerId = PASTE_SELLER_UUID
@buyerId = PASTE_BUYER_UUID

### 1. Đăng nhập ADMIN
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@liveorder.com",
  "password": "123456"
}

### 2. Đăng nhập SELLER
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "seller@liveorder.com",
  "password": "123456"
}

### 3. Đăng nhập BUYER
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "buyer@liveorder.com",
  "password": "123456"
}

### 4. ADMIN lấy danh sách người dùng
GET {{baseUrl}}/users?page=1&limit=10
Authorization: Bearer {{adminToken}}

### 5. BUYER lấy danh sách shop
GET {{baseUrl}}/messages/shops
Authorization: Bearer {{buyerToken}}

### 6. BUYER xem 5 tin mới nhất với một shop
GET {{baseUrl}}/messages/conversations/{{sellerId}}?limit=5&skip=0
Authorization: Bearer {{buyerToken}}

### 7. BUYER tải 5 tin cũ tiếp theo
GET {{baseUrl}}/messages/conversations/{{sellerId}}?limit=5&skip=5
Authorization: Bearer {{buyerToken}}

### 8. BUYER gửi câu hỏi riêng và nhận phản hồi AI
POST {{baseUrl}}/messages/conversations
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "sellerId": "{{sellerId}}",
  "message": "Áo này có size phù hợp cho người cao 1m60 không shop?"
}

### 9. SELLER lấy danh sách khách đã trò chuyện
GET {{baseUrl}}/messages/seller/customers
Authorization: Bearer {{sellerToken}}

### 10. SELLER xem 5 tin mới nhất với một Buyer
GET {{baseUrl}}/messages/seller/conversations/{{buyerId}}?limit=5&skip=0
Authorization: Bearer {{sellerToken}}

### 11. SELLER trả lời Buyer thủ công
POST {{baseUrl}}/messages/seller/conversations
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "buyerId": "{{buyerId}}",
  "message": "Shop đã kiểm tra lại và sẽ hỗ trợ bạn ngay nhé."
}

### 12. SELLER gửi thông báo VietQR cho Buyer
POST {{baseUrl}}/messages
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "receiverId": "{{buyerId}}",
  "amount": 150000,
  "orderId": "ORDER_001"
}

### 13. SELLER lấy Knowledge Base
GET {{baseUrl}}/ai/knowledge
Authorization: Bearer {{sellerToken}}

### 14. SELLER thêm Knowledge Base
POST {{baseUrl}}/ai/knowledge
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "keyword": "size áo",
  "answer": "Khách cao 1m60 và nặng khoảng 50kg có thể tham khảo size M."
}
