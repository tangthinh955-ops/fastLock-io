# Backend HTTP API base URL (local dev mặc định http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Tùy chọn: ghi đè URL Socket.io nếu khác domain API (mặc định dùng VITE_API_URL)
# VITE_SOCKET_URL=http://localhost:3001

# Tùy chọn: cấu hình Cloudinary Free (Unsigned Upload Preset) để Seller tải ảnh sản phẩm trực tiếp từ trình duyệt
# Tạo Unsigned Upload Preset tại Cloudinary Dashboard -> Settings -> Upload -> Upload presets
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

