# Local PostgreSQL supplied by docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/live_commerce?schema=public"

# Replace this example with your own long random secret before starting Backend.
JWT_SECRET="replace-with-your-own-long-random-secret"

# Supply your own Groq API key; never commit the real key.
GROQ_API_KEY=""

# Frontend currently connects to http://localhost:3001 (or VITE_API_URL in production).
PORT=3001

# Comma-separated browser origins allowed for HTTP & Socket.io CORS.
# Production (Render) example: https://liveorder-six.vercel.app,http://localhost:5173
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
